---
/* FOOTER-SPEC-2026 - five blocks; single followed timpaemi.com link; no network link walls. */
const year = new Date().getFullYear();
---
<footer class="site-footer"><!--FOOTER-SPEC-2026-->
  <div class="fs26-wrap">
    <div class="fs26-pub">
      <img class="fs26-photo" src="/authors/timpaemi.jpg" alt="Tim and Paemi" width="64" height="64" loading="lazy" />
      <div class="fs26-brand">Retire in Pattaya.</div>
      <p class="fs26-names">Written, researched and kept up to date by Tim and Paemi, who live in Pattaya. <a href="https://timpaemi.com/" rel="author noopener">&rarr; timpaemi.com</a></p>
      <p class="fs26-scale">Retirement in Thailand, done properly &mdash; visas, healthcare, housing and money, checked against primary sources.</p>
    </div>
    <nav class="fs26-nav" aria-label="Footer">
      <div><p class="fs26-h">// Explore</p><ul>
        <li><a href="/start-here/">Start here</a></li>
        <li><a href="/compare/">Compare destinations</a></li>
        <li><a href="/phuket/">Retire in Phuket</a></li>
        <li><a href="/bangkok/">Retire in Bangkok</a></li>
        <li><a href="/chiang-mai/">Retire in Chiang Mai</a></li>
      </ul></div>
      <div><p class="fs26-h">// Tools</p><ul>
        <li><a href="/tools/">Free tools</a></li>
        <li><a href="/resources/">Free guides</a></li>
        <li><a href="/glossary/">Glossary</a></li>
        <li><a href="/faq/">FAQ</a></li>
      </ul></div>
      <div><p class="fs26-h">// About</p><ul>
        <li><a href="/about/">About us</a></li>
        <li><a href="/editorial-standards/">How we work</a></li>
        <li><a href="/authors/">Our authors</a></li>
      </ul></div>
      <div><p class="fs26-h">// Legal</p><ul>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/disclaimer/">Disclaimer</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul></div>
    </nav>
    <p class="fs26-trust">Primary sources cited &middot; No paid placements &middot; Updated rolling</p>
    <p class="fs26-contact"><a href="mailto:info@retire-in-pattaya.com">info@retire-in-pattaya.com</a></p>
    <p class="fs26-legal">&copy; {year} TimPaemi Co., Ltd. &middot; <a href="/privacy/">Privacy</a> &middot; <a href="/disclaimer/">Disclaimer</a> &mdash; Not legal, financial, or immigration advice.</p>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid rgba(127,127,127,.25); margin-top: 3rem; }
  .fs26-wrap { max-width: 1080px; margin: 0 auto; padding: 2.8rem 1.25rem 1.5rem; text-align: left; }
  .fs26-pub { margin: 0 0 2.6rem; }
  .fs26-photo { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(127,127,127,.3); display: block; margin: 0 0 0.9rem; }
  .fs26-brand { font-weight: 800; font-size: 1.35rem; }
  .fs26-names { font-weight: 700; font-size: clamp(1.05rem, 2.2vw, 1.3rem); line-height: 1.4; margin: 0.8rem 0 0.5rem; max-width: 640px; }
  .fs26-names a { text-decoration: underline; text-underline-offset: 3px; }
  .fs26-scale { opacity: 0.7; font-size: 0.85rem; line-height: 1.55; margin: 0; max-width: 560px; }
  .fs26-nav { display: grid; grid-template-columns: 1fr; gap: 1.6rem; margin: 0 0 2.6rem; }
  @media (min-width: 760px) { .fs26-nav { grid-template-columns: repeat(4, 1fr); gap: 2rem; } }
  .fs26-h { font-size: 0.64rem; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.75; font-weight: 700; margin: 0 0 0.7rem; }
  .fs26-nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .fs26-nav a { opacity: 0.78; text-decoration: none; font-size: 0.85rem; color: inherit; }
  .fs26-nav a:hover { opacity: 1; text-decoration: underline; }
  .fs26-trust { font-size: 0.64rem; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.6; font-weight: 700; margin: 0 0 1.8rem; }
  .fs26-contact { margin: 0 0 1.8rem; font-size: 0.85rem; }
  .fs26-contact a { color: inherit; opacity: 0.78; text-decoration: none; }
  .fs26-legal { font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.55; margin: 0; border-top: 1px solid rgba(127,127,127,.25); padding-top: 0.9rem; line-height: 1.8; }
  .fs26-legal a { color: inherit; }
</style>
